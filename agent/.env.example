# QuerySage — Local Development Environment
# Copy this to .env and fill in real values. NEVER commit .env to git.

# ── GCP Configuration ──────────────────────────────────────────────────────
PROJECT_ID=your-gcp-project-id
REGION=us-central1
GEMINI_MODEL=gemini-2.0-flash-001

# ── AlloyDB Connection ─────────────────────────────────────────────────────
# Format: postgresql+psycopg2://user:password@<alloydb_private_ip>:5432/dbname
# For local dev via AlloyDB Auth Proxy: use 127.0.0.1 as host
ALLOYDB_DB_URL=postgresql+psycopg2://querysage_admin:REPLACE_PASSWORD@127.0.0.1:5432/pharma_inventory

# ── AlloyDB AI NL Config ───────────────────────────────────────────────────
NL_CONFIG_NAME=querysage_pharma_config

# ── Application ────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8080
